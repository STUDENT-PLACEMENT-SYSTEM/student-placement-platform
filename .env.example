# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Student Placement Analytics Platform"
SECRET_KEY=super-secret-random-32-byte-hex-key-here-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=placement_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/placement_db

# Redis (Pub/Sub & Caching & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_RESUMES=placement-resumes
MINIO_BUCKET_JDS=placement-jds
MINIO_BUCKET_OFFERS=placement-offers
MINIO_USE_SSL=false

# LLM & AI Agents (OpenAI or Local)
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# FastMCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
